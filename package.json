{
  "name": "hyprland-setup",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "prepare": "husky"
  },
  "devDependencies": {
    "@johnnymorganz/stylua": "^2.5.2",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "prettier": "^3.9.6"
  },
  "lint-staged": {
    "*.sh": [
      "shfmt -w -i 2 -sr"
    ],
    "*.lua": [
      "stylua --indent-type Spaces --indent-width 2"
    ],
    "*.qml": [
      "qmlformat -i"
    ],
    "*.{json,md,yml,yaml}": [
      "npx prettier --write"
    ]
  }
}
