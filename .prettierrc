{
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "es5",
  "printWidth": 100,
  "endOfLine": "lf",
  "plugins": ["prettier-plugin-sh"],
  "overrides": [
    {
      "files": "*.jsonc",
      "options": {
        "parser": "jsonc",
        "trailingComma": "none"
      }
    }
  ]
}
