#!/usr/bin/env bash
# Interactive screen recording launcher (wf-recorder + gpu-screen-recorder portal)

VIDEOS_DIR="$HOME/Videos"
mkdir -p "$VIDEOS_DIR"

# Stop an existing recording if one is running.
# pgrep -x matches the 15 first chars of the process name,
# so "gpu-screen-recorder" must be written "gpu-screen-reco".
for rec in wf-recorder gpu-screen-reco; do
  if pgrep -x "$rec" > /dev/null; then
    pkill -INT -x "$rec"
    notify-send "Screen Recorder" "Recording stopped" -i video-x-generic
    exit 0
  fi
done

# Interactive selection using Walker in dmenu mode
CHOICE=$(printf '%s\n' \
  "1. Area selection (Zone)" \
  "2. Window app" \
  "3. Full screen" | walker -d -p "Record mode:")

TIMESTAMP=$(date +%Y-%m-%d_%H-%M-%S)
OUTPUT_FILE="$VIDEOS_DIR/recording_${TIMESTAMP}.mp4"

case "$CHOICE" in
  *"Area"*)
    GEOM=$(slurp) || exit 0
    wf-recorder -g "$GEOM" -f "$OUTPUT_FILE" &
    ;;
  *"Window"*)
    # The portal picker lets you choose the window once, then it keeps recording it
    gpu-screen-recorder -w portal -f 60 -o "$OUTPUT_FILE" &
    ;;
  *"Full screen"*)
    OUTPUT=$(hyprctl monitors -j | jq -r '.[] | select(.focused==true) | .name')
    [ -n "$OUTPUT" ] && wf-recorder -o "$OUTPUT" -f "$OUTPUT_FILE" &
    ;;
  *)
    exit 0
    ;;
esac

sleep 0.5
if pgrep -x wf-recorder > /dev/null || pgrep -x gpu-screen-reco > /dev/null; then
  notify-send "Screen Recorder" "Recording started..." -i video-x-generic
fi
